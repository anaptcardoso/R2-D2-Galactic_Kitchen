<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="r2d2Kitchen" transaction-type="RESOURCE_LOCAL">

        <!-- Entidades JPA -->
        <class>org.model.entity.Recipe</class>
        <class>org.model.entity.Ingredient</class>
        <class>org.model.entity.UserProfile</class>
        <class>org.model.entity.WeeklyPlan</class>

        <properties>

            <!--  PostgreSQL -->
            <property name="jakarta.persistence.jdbc.driver"
                      value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:5432/chefbot"/>
            <property name="jakarta.persistence.jdbc.user"
                      value="postgres"/>
            <property name="jakarta.persistence.jdbc.password"
                      value="SUA_PASSWORD"/>

            <!-- Hibernate -->
            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.PostgreSQLDialect"/>

            <!-- update — cria/atualiza tabelas automaticamente sem apagar dados -->
            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>

            <!-- Mostra o SQL gerado na consola -->
            <property name="hibernate.show_sql"
                      value="true"/>
            <property name="hibernate.format_sql"
                      value="true"/>

            <!-- Desativa o lazy loading fora de transações -->
            <property name="hibernate.enable_lazy_load_no_trans"
                      value="true"/>

        </properties>

    </persistence-unit>

</persistence>